<Project Sdk="Microsoft.NET.Sdk">
  <!-- La base SQLite, par Entity Framework Core (ADR-0001, D3) : son schéma évolue par les migrations de
       Persistance/Migrations, versionnées dans le dépôt. Ajouter une migration, depuis la racine du dépôt :
       dotnet tool restore
       dotnet ef migrations add <Nom> -p src/Sollicito.Infrastructure -s src/Sollicito.Api -o Persistance/Migrations -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <!-- Data Protection, qui chiffre la clé d'IA (ADR-0001, D9 ; ADR-0016), vient du framework partagé d'ASP.NET Core,
       que l'API et la fenêtre embarquent déjà : aucun paquet de plus. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sollicito.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sollicito.Application\Sollicito.Application.csproj" />
  </ItemGroup>
</Project>
