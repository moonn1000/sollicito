{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "initial-version": "1.0.0",
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore${scope}: version${component} ${version}",
  "pull-request-header": "Version préparée par release-please. La fusionner crée l'étiquette et la version en brouillon, puis lance la construction de l'exe ; le mainteneur publie ensuite le brouillon.",
  "pull-request-footer": "Pull request ouverte par release-please, à partir des commits fusionnés sur main.",
  "label": "version : en attente",
  "release-label": "version : étiquetée",
  "changelog-sections": [
    { "type": "feat", "section": "Nouveautés" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performances" },
    { "type": "revert", "section": "Retours en arrière" }
  ],
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["Directory.Build.props"]
    }
  }
}
