<Project>
  <!-- Réglages communs à tous les projets .NET du dépôt. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Version du produit, portée par l'exe. La pull request de version de release-please la réécrit sur la ligne
       annotée (release-please-config.json, extra-files ; ADR-0009) : 0.0.0 tant qu'aucune version n'est sortie. -->
  <PropertyGroup>
    <Version>0.0.0</Version> <!-- x-release-please-version -->
  </PropertyGroup>

  <!-- Versions des paquets figées par un fichier de verrouillage par projet. En CI, une
       restauration qui changerait ces fichiers échoue au lieu de les réécrire. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
